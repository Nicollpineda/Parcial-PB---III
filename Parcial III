        cout << "2. Comentarios desde fecha\n";
        cout << "3. Listar usuarios\n";
        cout << "4. Agregar al carrito\n";
        cout << "5. Ver carrito\n";
        cout << "6. Guardar carrito\n";
        cout << "7. Salir\n";
        cout << "8. 5 productos con menor stock\n";
        cout << "9. Cantidad de comentarios por fecha\n";
        cout << "10. Precio maximo y minimo\n";
        cout << "Seleccione una opción: ";
        cin >> op;
        cin.ignore();

        if (op == 1) listarProductosBajoStock(productos);
        if (op == 2) 
        {
            string fecha;
            cout << "Fecha (YYYY-MM-DD): ";
            getline(cin, fecha);
            listarComentariosDesdeFecha(comentarios, fecha);
        }
        if (op == 3) listarUsuarios(usuarios);
        if (op == 4) 
        {
            int id;
            cout << "ID producto: ";
            cin >> id;
            cin.ignore();
            agregarAlCarrito(carrito, productos, id);
        }
        if (op == 5) mostrarCarrito(carrito);
        if (op == 6) guardarCarrito(carrito);
        if (op == 8) cincoMenorStock(productos);
        if (op == 9) cantidadComentariosFecha(comentarios);
        if (op == 10) precioMaxMin(productos);

    } while (op != 7);

    return 0;
}
