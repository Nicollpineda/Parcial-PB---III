#include <iostream>
#include <fstream>
#include <sstream>
#include <vector>
#include <algorithm>
using namespace std;

struct Usuario 
{
    int idUsuario;
    string nombre;
    string correoElectronico;
    string contrasena;
    string direccion;
    string metodoDePago;
};

struct Producto 
{
    int idProducto;
    string nombre;
    string descripcion;
    double precio;
    int stock;
};

struct Comentario 
{
    int idComentario;
    string producto;
    string usuario;
    string comentario;
    string fecha;
};

struct CarritoDeCompras 
{
    int idCarrito;
    vector<Producto> productos;
    double subtotal;
    double impuestos;
};

vector<Usuario> cargarUsuarios(const string &ruta) 
{
    vector<Usuario> usuarios;
    ifstream file(ruta);
    string linea;
    getline(file, linea);

    while (getline(file, linea)) 
    {
        if (linea.empty()) continue;
        stringstream ss(linea);
        string campo;
        Usuario u;

        getline(ss, campo, ','); u.idUsuario = stoi(campo);
        getline(ss, u.nombre, ',');
        getline(ss, u.correoElectronico, ',');
        getline(ss, u.contrasena, ',');
        getline(ss, u.direccion, ',');
        getline(ss, u.metodoDePago, ',');

        usuarios.push_back(u);
    }
    return usuarios;
}

vector<Producto> cargarProductos(const string &ruta) 
{
    vector<Producto> productos;
    ifstream file(ruta);
    string linea;
    getline(file, linea);

    while (getline(file, linea)) 
    {
        if (linea.empty()) continue;
        stringstream ss(linea);
        string campo;
        Producto p;

        getline(ss, campo, ','); p.idProducto = stoi(campo);
        getline(ss, p.nombre, ',');
        getline(ss, p.descripcion, ',');
        getline(ss, campo, ','); p.precio = stod(campo);
        getline(ss, campo, ','); p.stock = stoi(campo);

        productos.push_back(p);
    }
    return productos;
}

vector<Comentario> cargarComentarios(const string &ruta) 
{
    vector<Comentario> comentarios;
    ifstream file(ruta);
    string linea;
    getline(file, linea);

    while (getline(file, linea)) 
    {
        if (linea.empty()) continue;
        stringstream ss(linea);
        string campo;
        Comentario c;

        getline(ss, campo, ','); c.idComentario = stoi(campo);
        getline(ss, c.producto, ',');
        getline(ss, c.usuario, ',');
        getline(ss, c.comentario, ',');
        getline(ss, c.fecha, ',');

        comentarios.push_back(c);
    }
    return comentarios;
}

Usuario* iniciarSesion(vector<Usuario> &usuarios, const string &correo, const string &clave) 
{
    for (auto &u : usuarios) 
    {
        if (u.correoElectronico == correo && u.contrasena == clave) 
        {
            return &u;
        }
    }
    return nullptr;
}

void listarProductosBajoStock(vector<Producto> &productos) 
{
    for (auto &p : productos) 
    {
        if (p.stock < 15) 
        {
            cout << p.idProducto << " - " << p.nombre << " (Stock: " << p.stock << ")\n";
        }
    }
}

void listarUsuarios(vector<Usuario> &usuarios) 
{
    for (auto &u : usuarios) 
    {
        cout << u.idUsuario << " - " << u.nombre << " - "
             << u.correoElectronico << " - "
             << u.direccion << " - "
             << u.metodoDePago << "\n";
    }
}

void listarComentariosDesdeFecha(vector<Comentario> &comentarios, const string &fecha) 
{
    for (auto &c : comentarios) 
    {
        if (c.fecha >= fecha) 
        {
            cout << c.idComentario << " - " << c.producto << " - " << c.usuario
                 << " - " << c.fecha << "\n" << c.comentario << "\n\n";
        }
    }
}

Producto* buscarProductoPorID(vector<Producto> &productos, int id) 
{
    for (auto &p : productos) 
    {
        if (p.idProducto == id) return &p;
    }
    return nullptr;
}

void agregarAlCarrito(CarritoDeCompras &carrito, vector<Producto> &productos, int id) 
{
    Producto* p = buscarProductoPorID(productos, id);
    if (!p) return;
    carrito.productos.push_back(*p);
    carrito.subtotal += p->precio;
    carrito.impuestos = carrito.subtotal * 0.19;
}

void mostrarCarrito(CarritoDeCompras &carrito) 
{
    for (auto &p : carrito.productos) 
    {
        cout << p.idProducto << " - " << p.nombre << " - " << p.precio << "\n";
    }
    cout << "Subtotal: " << carrito.subtotal << "\n";
    cout << "Impuestos: " << carrito.impuestos << "\n";
}

void guardarCarrito(CarritoDeCompras &carrito) 
{
    ofstream f("Carrito.txt");
    for (auto &p : carrito.productos) 
    {
        f << p.idProducto << "," << p.nombre << "," << p.precio << "\n";
    }
}
