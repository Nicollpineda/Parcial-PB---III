void cincoMenorStock(vector<Producto> productos)//productos con menor stock
{
    sort(productos.begin(), productos.end(),
         [](Producto a, Producto b) { return a.stock < b.stock; });

    cout << "\n--- 5 PRODUCTOS CON MENOR STOCK ---\n";
    for (int i = 0; i < 5 && i < productos.size(); i++) 
    {
        cout << productos[i].idProducto << " - "
             << productos[i].nombre << " - Stock: "
             << productos[i].stock << endl;
    }
}

void cantidadComentariosFecha(vector<Comentario> &comentarios) // contador de comentarios de fecha exacta 
{
    string fecha;
    cout << "Ingrese la fecha (YYYY-MM-DD): ";
    getline(cin, fecha);

    int contador = 0;

    for (auto &c : comentarios) {
        if (c.fecha == fecha) {
            contador++;
        }
    }

    cout << "\n--- CANTIDAD DE COMENTARIOS EN ESA FECHA ---\n";
    cout << "Fecha: " << fecha << "\n";
    cout << "Número de comentarios: " << contador << "\n";
}


void precioMaxMin(vector<Producto> &productos) //precio maxi y mini
{
    if (productos.empty()) 
    {
        cout << "No hay productos.\n";
        return;
    }

    double maxP = productos[0].precio;
    double minP = productos[0].precio;

    for (auto &p : productos) {
        if (p.precio > maxP) maxP = p.precio;
        if (p.precio < minP) minP = p.precio;
    }

    cout << "\n--- PRECIOS MAXIMO Y MINIMO ---\n";
    cout << "MAXIMO: " << maxP << endl;
    cout << "MINIMO: " << minP << endl;
}

int main() 
{
    vector<Usuario> usuarios = cargarUsuarios("Usuarios.txt");
    vector<Producto> productos = cargarProductos("Productos.txt");
    vector<Comentario> comentarios = cargarComentarios("Comentarios.txt");

    CarritoDeCompras carrito;
